#include <bits/stdc++.h>
using namespace std;

string longestPalindrome(string s){
    if(s.empty()) return "";

    // 1. Transform string
    string t = "^";
    for(char c : s){
        t += "#";
        t += c;
    }
    t += "#$";

    int n = t.length();
    vector<int> P(n, 0);

    int center = 0, right = 0;

    // 2. Manacher
    for(int i = 1; i < n - 1; i++){
        int mirror = 2 * center - i;

        if(i < right)
            P[i] = min(right - i, P[mirror]);

        // Expand around center i
        while(t[i + 1 + P[i]] == t[i - 1 - P[i]])
            P[i]++;

        // Update center & right
        if(i + P[i] > right){
            center = i;
            right = i + P[i];
        }
    }

    // 3. Find max
    int maxLen = 0, centerIndex = 0;
    for(int i = 1; i < n - 1; i++){
        if(P[i] > maxLen){
            maxLen = P[i];
            centerIndex = i;
        }
    }

    // 4. Extract result
    int start = (centerIndex - maxLen) / 2;
    return s.substr(start, maxLen);
}

int main(){
    string s;
    cin >> s;
    cout << longestPalindrome(s);
    return 0;
}
